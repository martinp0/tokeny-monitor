    },
    "Import usage": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načíst využití"
          }
        }
      }
    },
    "Imported on this iPhone": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Načteno na tomhle iPhonu"
          }
        }
      }
    },
    "In the Claude console open Usage or Cost and export CSV. Or create an Admin key. A normal API key cannot read the usage report. Tokeny sends the key only to api.anthropic.com.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V konzoli Claude otevři Usage nebo Cost a exportuj CSV. Nebo vytvoř admin klíč. Běžný klíč k API report využití nepřečte. Tokeny ho posílají jen na api.anthropic.com."
          }
        }
      }
    },
    "Included in plan": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "V tarifu"
          }
        }
      }
    },
    "Is my AI budget OK?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Je rozpočet na AI v pořádku?"
          }
        }
      }
    },
    "Koruna amounts use %@ per dollar, the ČNB rate of %@. Tips use this rate when amounts are in koruna.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Částky v korunách používají %1$@ za dolar, kurz ČNB ze dne %2$@. Tipy používají tenhle kurz, když jsou částky v korunách."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Koruna amounts use %1$@ per dollar, the ČNB rate of %2$@. Tips use this rate when amounts are in koruna."
          }
        }
      }
    },
    "Koruna amounts use the app fallback of 23.5 Kč per dollar. The fallback has no ČNB date. Tips use this rate when amounts are in koruna.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",

# ── Frontend (Vite, public) ─────────────────────────────────────────────
# Show "Continue with Apple" once Apple is configured in Neon Auth.
# VITE_AUTH_APPLE_ENABLED=true

# ── Server (Vercel Function env; never commit real values) ─────────────
# Neon Postgres (project "tokeny"), pooled connection string
# DATABASE_URL=postgresql://...
# Neon Auth (Better Auth) base URL, e.g. https://ep-xxx.neonauth.<region>.aws.neon.tech/neondb/auth
# NEON_AUTH_BASE_URL=
# ≥32 random chars, signs the session cache cookie
# NEON_AUTH_COOKIE_SECRET=
# 32 random bytes, base64 — encrypts provider API keys (AES-256-GCM)
# CREDENTIALS_ENCRYPTION_KEY=
# Bearer secret for /api/cron/daily (Vercel Cron sends it automatically)
# CRON_SECRET=
# APP_URL=https://tokeny.martinpohl.cz

# Optional

# Stripe
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_PRICE_MONTHLY=price_...       # control, 99 Kč / month
# STRIPE_PRICE_YEARLY=price_...        # control, 990 Kč / year
# STRIPE_PRICE_MONTHLY_B=price_...     # variant B, 79 Kč / month; omit both B prices to keep everyone on control
# STRIPE_PRICE_YEARLY_B=price_...      # variant B, 790 Kč / year
# STRIPE_PORTAL_CONFIGURATION=bpc_...   # Tokeny-branded customer portal (account default belongs to another product)
# STRIPE_TRIAL_DAYS=14                 # must match the 14-day copy; 0 or unset means no trial at checkout
# STRIPE_WEBHOOK_SECRET=whsec_...   # endpoint: https://tokeny.martinpohl.cz/api/stripe-webhook
# PRICING_ADMIN_EMAIL=you@example.com  # comma-separated; GET /api/pricing/experiment. Empty hides the route.
# APPLE_SANDBOX_PRO_ALLOWLIST=         # user ids or e-mails that may be Pro from Sandbox/Xcode. Empty grants none.

# Optional App Store Server API (NOT used for verification; local JWS works without these).
# See docs/apple-iap.md. Never commit the .p8.
# APPLE_ISSUER_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

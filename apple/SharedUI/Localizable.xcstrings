          }
        }
      }
    },
    "That file is too large to open in the app.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soubor je na otevření v appce moc velký."
          }
        }
      }
    },
    "The Tokeny server is being updated. Try again in a few minutes.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server Tokenů se právě aktualizuje. Zkus to za pár minut."
          }
        }
      }
    },
    "The budget bar stays on this iPhone. The app does not send alerts for a file.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pruh rozpočtu zůstává na tomhle iPhonu. Appka kvůli souboru neposílá upozornění."
          }
        }
      }
    },
    "The server had a problem. Try again later.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na serveru nastala chyba. Zkus to později."
          }
        }
      }
    },
    "This app does not start Sign in with Apple. The registered Apple bundle has no Sign in with Apple capability.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Appka přihlášení přes Apple nespouští. U registrovaného Apple balíčku ta možnost není."
          }
        }
      }
    },
    "This e-mail already has an account. Sign in instead.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "S tímhle e-mailem už účet existuje. Přihlas se."
          }
        }
      }
    },
    "This file is not an OpenRouter activity export or a Cursor or Grok Bot usage export.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tenhle soubor není export aktivity z OpenRouteru ani export útraty z Cursoru nebo Grok Bota."
          }
        }
      }
    },
    "This month": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tento měsíc"
          }
        }
      }
    },
    "This month's AI spend and your budget.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Útrata za AI tento měsíc a rozpočet."
          }
        }
      }
    },
    "This needs Tokeny Pro.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle je součást Tokeny Pro."
          }
        }
      }
    },
    "This permanently deletes your account, provider keys and usage history. Any Pro subscription is canceled immediately, with no refund for the rest of the period.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Natrvalo smaže účet, klíče k poskytovatelům i historii. Případné předplatné Pro se okamžitě ukončí, bez vrácení peněz za zbytek období."
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes"
          }
        }
      }
    },
    "Today %@": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes %@"
          }
        }
      }
    },
    "Today %@, this month %@.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnes %1$@, tento měsíc %2$@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today %1$@, this month %2$@."
          }
        }
      }
    },
    "Tokens": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokeny"
          }
        }
      }
    },
    "Tokeny": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokeny"
          }
        }
      }
    },
    "Tokeny Pro": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokeny Pro"
          }
        }
      }
    },
    "Tokeny Pro on your account adds the server month-end forecast, budget alerts, exports and shared dashboards. This app does not sell Pro. No App Store product is set up.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokeny Pro na účtu přidává odhad do konce měsíce ze serveru, upozornění na rozpočet, exporty a sdílené přehledy. Tahle appka Pro neprodává. V App Storu není nastavený žádný produkt."
          }
        }
      }
    },
    "Tokeny notifies you once when you reach your alert threshold and once at 100 % of your monthly budget. Set the budget on the web.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokeny tě upozorní jednou při dosažení prahu a jednou při 100 % měsíčního rozpočtu. Rozpočet nastavíš na webu."
          }
        }
      }
    },
    "Top models": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdražší modely"
          }
        }
      }
    },

    },
    "Full history, month-end forecast, budget alerts and unlimited providers.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Celá historie, odhad na konec měsíce, upozornění na rozpočet a neomezeně poskytovatelů."
          }
        }
      }
    },
    "Gemini": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemini"
          }
        }
      }
    },
    "Google AI Studio has no usage or cost API. In Google Cloud Billing open Reports, filter to Generative Language API or Vertex AI, group by Date and SKU, then Download CSV. Tokeny reads the Subtotal in USD and skips other services. Do not paste a Gemini API key.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Google AI Studio nemá API využití ani nákladů. V Google Cloud Billing otevři Reports, filtruj na Generative Language API nebo Vertex AI, seskup podle Date a SKU a stáhni CSV. Tokeny čte Subtotal v USD a ostatní služby přeskočí. Klíč ke Gemini nevkládej."
          }
        }
      }
    },
    "Grok Bot and Cursor": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Grok Bot a Cursor"
          }
        }
      }
    },
    "Half of the uncached input, priced as a cache read. The first write is not subtracted.": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Polovina dosud nekešovaného vstupu, oceněná jako čtení z cache. První zápis se neodečítá."
          }
        }
      }
    },
    "High confidence": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysoká jistota"
          }
        }
      }
    },
    "How much did I spend on AI today?": {
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolik jsem dnes utratil za AI?"
